LocPromotionPopupText="<Bullet> Undead enemies include psi zombies, spectral zombies, Spectral Lancers, the Lost, Shadowbound units and Chryssalid cocoons."
LocFlyOverText="Undertaker"

[M31_Unload X2AbilityTemplate]
LocFriendlyName="Unload"
LocLongDescription="Fire your <Ability:M31_BoundWeaponName> at the target until you run out of ammo or hit <Ability:M31_Unload_MaxShots> shots. Each shot has a -<Ability:M31_Unload_AimPenalty> aim penalty. Has a <Ability:M31_SelfCooldown> turn cooldown."
LocHelpText="Fire your <Ability:M31_BoundWeaponName> at the target until you run out of ammo or hit <Ability:M31_Unload_MaxShots> shots. Each shot has a -<Ability:M31_Unload_AimPenalty> aim penalty."
LocPromotionPopupText="<Bullet> <Ability:M31_FriendlyName> shots can crit: <Ability:M31_Unload_bAllowCrit>.<br><Bullet> Has a <Ability:M31_SelfCooldown> turn cooldown."
LocFlyOverText="Unload"

